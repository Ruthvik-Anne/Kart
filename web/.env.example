# PostgreSQL connection for the auth layer (src/server, src/app/api/auth, src/proxy.ts).
# Local dev with Docker:
#   docker run -d --name kart-postgres -e POSTGRES_USER=kart -e POSTGRES_PASSWORD=kart_local_dev -e POSTGRES_DB=kart -p 5432:5432 postgres:17-alpine
# Then: copy this file to .env.local and run `npm run db:seed`.
DATABASE_URL=postgresql://kart:kart_local_dev@localhost:5432/kart

# Set to "true" when your Postgres requires TLS (managed databases).
DATABASE_SSL=false
