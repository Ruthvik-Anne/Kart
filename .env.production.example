# Copy to a private deployment secret store; never commit real values.
KART_SESSION_SECRET=replace-with-at-least-32-random-characters
KART_OIDC_ISSUER=https://identity.example.edu
KART_OIDC_AUTHORIZE_URL=https://identity.example.edu/authorize
KART_OIDC_TOKEN_URL=https://identity.example.edu/token
KART_OIDC_JWKS_URL=https://identity.example.edu/jwks
KART_OIDC_CLIENT_ID=kart-campus
KART_OIDC_CLIENT_SECRET=replace-with-provider-client-secret
KART_OIDC_REDIRECT_URI=https://kart.example.edu/api/backend/auth/callback
KART_CAMPUS_DOMAINS={"example.edu":"example-campus"}
KART_BOOTSTRAP_ADMINS=admin@example.edu
